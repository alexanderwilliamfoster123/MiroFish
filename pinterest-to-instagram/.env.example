# ---- Claude (tagging, theming, captions) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Pinterest API v5 ----
# Business account + approved app. Trial tier works for reading your own boards.
# https://developers.pinterest.com/docs/api/v5/
PINTEREST_ACCESS_TOKEN=
# Comma-separated board IDs to harvest from. Leave blank to use every board you own.
PINTEREST_BOARD_IDS=

# ---- Publishing: pick ONE of the two adapters ----
# "metricool" = queue into the Metricool planner (human can review/approve)
# "graph"     = publish straight to Instagram via the Meta Graph API
PUBLISH_ADAPTER=metricool

# Metricool (https://app.metricool.com -> Settings -> API)
METRICOOL_USER_ID=
METRICOOL_USER_TOKEN=
METRICOOL_BLOG_ID=
METRICOOL_BASE_URL=https://app.metricool.com/api
# false = lands as a draft in the planner for review; true = Metricool auto-publishes
METRICOOL_AUTO_PUBLISH=false

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# ---- Where rendered slides are written and served from ----
# The Graph API and Metricool both fetch media by URL, so slides must be
# reachable over public HTTPS. Point this at your CDN/bucket public prefix.
MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/carousels
MEDIA_UPLOAD_CMD=

# ---- Scheduling ----
POST_TIME_LOCAL=09:00
TIMEZONE=Europe/London
